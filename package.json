{
  "name": "jianpu-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "丝滑的网页简谱（numbered musical notation）编辑器：SVG 纯文本排版、Web Audio 回放、MIDI 导入导出与 WAV 导出。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/core/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/jianpu-editor.git"
  },
  "homepage": "https://jianpu.webkubor.online/",
  "keywords": [
    "jianpu",
    "numbered musical notation",
    "notation",
    "music",
    "svg",
    "web-audio",
    "midi"
  ],
  "author": "webkubor",
  "bugs": {
    "url": "https://github.com/webkubor/jianpu-editor/issues"
  }
}
